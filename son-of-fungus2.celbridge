[celbridge]
celbridge-version = "1.6.0"
project-version = "1.0.0"

[celbridge.explorer]
exclude = [".gitignore", ".DS_Store", "Thumbs.db", "desktop.ini", "package-lock.json"]

[celbridge.search]
exclude = ["node_modules", "dist", "test-results"]

[celbridge.packages]
folders = ["packages"]

[[shortcut]]
resource = "terminal.console"
icon = "bs-terminal"
area = "bottom"
open-on-load = true

[[shortcut]]
resource = "README.md"
icon = "bs-book"
area = "side"
open-on-load = true

[[shortcut]]
resource = "dist/index.html"
icon = "bs-window"
area = "side"
open-on-load = true
